{
  "name": "yildiz-amigurumi-webpage",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/sync-blog-layout.cjs && prettier --write \"blog/**/*.html\" && node scripts/build-site.cjs",
    "sync:layout": "node scripts/sync-blog-layout.cjs && prettier --write \"blog/**/*.html\"",
    "format": "prettier --write \"index.html\" \"blog/**/*.html\" \"assets/**/*.{css,js}\" \"scripts/build-site.cjs\"",
    "lint:js": "eslint assets/app.js scripts/build-site.cjs scripts/sync-blog-layout.cjs",
    "lint:css": "stylelint \"assets/styles.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "test:mobile-touch": "node scripts/mobile-touch-smoke.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "bootstrap": "^5.3.8",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "purgecss": "^8.0.0",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.1"
  }
}
